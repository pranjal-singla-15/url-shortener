<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Home Page</title>
</head>
<body>
  <h1>URL Shortener</h1>
  <div>
    <form method="POST" action="/url">
      <label>Enter your original url</label>
      <input type="text" name="url" placeholder="https://example.com"/>
      <button type="submit">Generate</button>
    </form>
  </div>

  <% if (locals.urls && urls.length > 0) { %>
    <div>
      <h2>Generated URLs</h2>
      <table border="1" style="margin-top: 20px; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="padding: 8px;">Short ID</th>
            <th style="padding: 8px;">Original URL</th>
            <th style="padding: 8px;">Short URL</th>
            <th style="padding: 8px;">Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach(url => { %>
            <tr>
              <td style="padding: 8px;"><%= url.shortId %></td>
              <td style="padding: 8px;"><%= url.redirectedURL %></td>
              <td style="padding: 8px;">
                <a href="/<%= url.shortId %>" target="_blank">
                  http://localhost:4000/<%= url.shortId %>
                </a>
              </td>
              <td style="padding: 8px;"><%= url.visitHistory.length %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="margin-top: 20px;">
      <p>No URLs generated yet.</p>
    </div>
  <% } %>

</body>
</html>
